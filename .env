# =============================================================
#  .env.example — variáveis de ambiente da API de Reservas
#
#  Como usar:
#    cp .env.example .env
#    edite o .env com os valores reais
#
#  IMPORTANTE: o .env NUNCA deve ser commitado no Git.
#  Adicione ao .gitignore: .env
# =============================================================

# ── Banco de dados (obrigatório em produção) ──────────────────
DB_USERNAME=
DB_PASSWORD=


# ── Perfil Spring ─────────────────────────────────────────────
# Valores aceitos: dev | test | prod
SPRING_PROFILES_ACTIVE=dev

# ── Servidor ──────────────────────────────────────────────────
SERVER_PORT=8080

# ── JVM (opcional — sobreposição das flags do entrypoint) ─────
# JVM_OPTS=-Xms256m -Xmx512m

# ── Logs ──────────────────────────────────────────────────────
# Nível de log para o pacote da aplicação
# Valores: TRACE | DEBUG | INFO | WARN | ERROR
LOGGING_LEVEL_COM_SEUPROJETO=INFO
